NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialer

VOICE_PROVIDER=mock
MOCK_PROVIDER_DELAY_MS=50
MOCK_PROVIDER_FAILURE_RATE=0

# Auto-progress mock calls (defaults live in MOCK_AUTO_SIMULATE_DEFAULTS;
# optional env overrides below)
MOCK_AUTO_SIMULATE=true
# MOCK_AUTO_ANSWER_RATE=
# MOCK_AUTO_MIN_STEP_MS=
# MOCK_AUTO_MAX_STEP_MS=
# MOCK_AUTO_MIN_TALK_MS=
# MOCK_AUTO_MAX_TALK_MS=

SERVICE_API_KEY=
LOG_LEVEL=info

CREATING_ATTEMPT_TIMEOUT_SECONDS=30
PUBLIC_BASE_URL=http://localhost:3000

# Optional: Nebula Supabase (powers agent dropdown in the visualizer)
NEBULA_SUPABASE_URL=
NEBULA_SUPABASE_SERVICE_ROLE_KEY=
